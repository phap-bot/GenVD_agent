GEMINI_API_KEY=replace-with-your-google-gemini-key
AUTODUB_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AUTODUB_TRANSLATION_PROVIDER=9router
AUTODUB_9ROUTER_BASE_URL=http://localhost:20128/v1
AUTODUB_9ROUTER_API_KEY=replace-with-your-9router-token
AUTODUB_TRANSLATION_MODEL=ag/gemini-3-flash-agent
AUTODUB_TRANSLATION_FALLBACK_MODELS=ag/gemini-3-flash-agent,ag/gemini-3.5-flash-low,ag/gemini-3-flash,gemini/gemini-3-flash-preview
AUTODUB_TRANSLATION_FALLBACK=google
AUTODUB_TRANSLATION_ATTEMPT_TIMEOUT=30
AUTODUB_TRANSLATION_BATCH_SIZE=80
AUTODUB_TRANSLATION_BATCH_WORDS=750
AUTODUB_TRANSLATION_BATCH_CHARS=12000
AUTODUB_TRANSLATION_CONCURRENCY=4
AUTODUB_TRANSLATION_COHERENCE_BATCH_SIZE=24
AUTODUB_TRANSLATION_COHERENCE_TIMEOUT=18
TRANSLATE_BATCH_SIZE=80
TRANSLATE_ANALYSIS=true
TRANSLATE_REVIEW=true
TRANSLATE_CPS_BUDGET=12.5
VIDEO_SPEED=1.0
VOICE_SPEED=1.0
SOFT_TIMING_FIT=true
TIMING_MAX_DRIFT_S=1.5
TIMING_MIN_GAP_S=0.12
TIMING_MAX_ATEMPO=1.1
HQ_BACKGROUND=true
VOICE_POSTPROCESS=true
VOICE_TARGET_LUFS=-16.0
BG_DUCK_VOICE_DB=-7.0
AUTODUB_CHECKPOINT_ROOT=temp/checkpoints
AUTODUB_CHECKPOINT_ENABLED=true
AUTODUB_TEMP_CLEANUP_MAX_AGE_HOURS=24
AUTODUB_TEMP_CLEANUP_INTERVAL_HOURS=24
AUTODUB_OUTPUT_CLEANUP_MAX_AGE_HOURS=12
AUTODUB_OUTPUT_CLEANUP_INTERVAL_HOURS=1
AUTODUB_VENV_WHISPER=.venv-whisper
AUTODUB_VENV_ASR=.venv-asr
AUTODUB_VENV_VIENEU=.venv-vieneu
AUTODUB_VIENEU_BACKBONE_REPO=models/VieNeu-TTS-v3-Turbo
AUTODUB_VIENEU_MODEL_SUBFOLDER=update
AUTODUB_VIENEU_ONNX_DIR=models/VieNeu-TTS-v3-Turbo/onnx_int8
AUTODUB_VIENEU_BATCH_SIZE=16
AUTODUB_VIENEU_MAX_CHARS=384
AUTODUB_OCR_MODEL=gemini/gemini-2.5-flash
AUTODUB_OCR_ADAPTIVE=true
AUTODUB_OCR_SCENE_THRESHOLD=0.28
AUTODUB_ASR_PROVIDER=whisperx
AUTODUB_ASR_ENGINE=auto
AUTODUB_ASR_MODEL=auto
AUTODUB_DEFAULT_SOURCE_LANG=zh-CN
AUTODUB_WHISPER_MODEL=auto
AUTODUB_COMPUTE_TYPE=float16
AUTODUB_WHISPER_BEAM_SIZE=1
AUTODUB_WHISPER_BATCH_SIZE=8
AUTODUB_WHISPER_VAD_FILTER=true
AUTODUB_STREAMING_PIPELINE=true
AUTODUB_ASR_BLOCK_SECONDS=120
AUTODUB_ASR_BLOCK_OVERLAP_SECONDS=1.5
AUTODUB_STREAM_QUEUE_SIZE=2
AUTODUB_STREAM_TRANSLATION_BLOCKS=3
ASR_ENGINE=auto
WHISPER_MODEL=auto
DEFAULT_SOURCE_LANG=zh-CN
WHISPER_BEAM_SIZE=1
AUTODUB_AUTO_PARAFORMER=1
AUTODUB_PARAFORMER_MODEL=models/paraformer-zh
AUTODUB_PARAFORMER_DEVICE=cpu
AUTODUB_PARAFORMER_VENV=.venv-asr
AUTODUB_STT_BASE_URL=http://localhost:20128/v1
AUTODUB_STT_API_KEY=replace-with-your-9router-token
AUTODUB_STT_MODEL=gemini/gemini-2.5-flash
AUTODUB_STT_FALLBACK_MODELS=gemini/gemini-2.5-flash-lite,gemini/gemini-3-flash-preview
AUTODUB_STT_UPLOAD_FORMAT=mp3
AUTODUB_STT_UPLOAD_BITRATE=32k
AUTODUB_STT_PROMPT=
AUTODUB_STT_RESPONSE_FORMAT=
# Keep one active model warm; the registry evicts other stages to CPU before
# switching, which avoids reloading the same model for every render.
AUTODUB_CPU_OFFLOAD=0
AUTODUB_GPU_LOCK_WAIT_TIMEOUT=180
AUTODUB_PRELOAD_MODELS=none
AUTODUB_PRELOAD_ASR_MODEL=base
AUTODUB_PRELOAD_COMPUTE_TYPE=float16
AUTODUB_PRELOAD_ALIGN_LANGS=
AUTODUB_PRELOAD_TTS_DEVICE=cuda
AUTODUB_QUEUE_BACKEND=local
AUTODUB_REDIS_URL=redis://127.0.0.1:6379/0
AUTODUB_RENDER_JOB_ROOT=render_jobs
AUTODUB_JOB_STALE_SECONDS=300
AUTODUB_RENDER_JOB_MAX_AGE_DAYS=7
AUTODUB_RENDER_AUTO_ATTEMPTS=3
AUTODUB_SHORT_VIDEO_MAX_SECONDS=120
AUTODUB_DEMUCS_DEVICE=auto
# Bound Demucs peak memory; long videos are processed in sequential chunks.
AUTODUB_DEMUCS_CHUNK_SECONDS=60
AUTODUB_VOICE_REFERENCE_MAX_BYTES=16777216
AUTODUB_X264_PRESET=superfast
AUTODUB_X264_CRF=22
AUTODUB_TRANSLATION_CONNECTION_REFUSED_RETRIES=2
AUTODUB_TRANSLATION_CONNECTION_REFUSED_RETRY_DELAY=1.5

