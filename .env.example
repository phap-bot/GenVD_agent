GEMINI_API_KEY=replace-with-your-google-gemini-key
AUTODUB_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AUTODUB_TRANSLATION_PROVIDER=9router
AUTODUB_9ROUTER_BASE_URL=http://localhost:20128/v1
AUTODUB_9ROUTER_API_KEY=replace-with-your-9router-token
AUTODUB_TRANSLATION_MODEL=ag/gemini-3-flash-agent
AUTODUB_TRANSLATION_FALLBACK_MODELS=ag/gemini-3-flash-agent,ag/gemini-3.5-flash-low,ag/gemini-3-flash,gemini/gemini-3-flash-preview
AUTODUB_TRANSLATION_FALLBACK=google
AUTODUB_TRANSLATION_ATTEMPT_TIMEOUT=30
AUTODUB_TRANSLATION_BATCH_SIZE=6
AUTODUB_TRANSLATION_BATCH_CHARS=900
AUTODUB_OCR_MODEL=gemini/gemini-2.5-flash
AUTODUB_ASR_PROVIDER=whisperx
AUTODUB_STT_BASE_URL=http://localhost:20128/v1
AUTODUB_STT_API_KEY=replace-with-your-9router-token
AUTODUB_STT_MODEL=gemini/gemini-2.5-flash
AUTODUB_STT_FALLBACK_MODELS=gemini/gemini-2.5-flash-lite,gemini/gemini-3-flash-preview
AUTODUB_STT_UPLOAD_FORMAT=mp3
AUTODUB_STT_UPLOAD_BITRATE=32k
AUTODUB_STT_PROMPT=
AUTODUB_STT_RESPONSE_FORMAT=
AUTODUB_CPU_OFFLOAD=0
AUTODUB_GPU_LOCK_WAIT_TIMEOUT=180
AUTODUB_PRELOAD_MODELS=none
AUTODUB_PRELOAD_ASR_MODEL=base
AUTODUB_PRELOAD_COMPUTE_TYPE=int8
AUTODUB_PRELOAD_ALIGN_LANGS=
AUTODUB_PRELOAD_TTS_DEVICE=cuda
AUTODUB_TRANSLATION_CONNECTION_REFUSED_RETRIES=2
AUTODUB_TRANSLATION_CONNECTION_REFUSED_RETRY_DELAY=1.5

